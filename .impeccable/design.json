    {
      "name": "Spine navigation",
      "kind": "nav",
      "refersTo": "nav-item-current",
      "description": "The linen binding with its dashed stitch; the current entry in deep linen.",
      "html": "<nav class=\"ds-spine\" aria-label=\"Main\"><a class=\"ds-nav-item\" href=\"#\">Today</a><a class=\"ds-nav-item\" href=\"#\" aria-current=\"page\">Library</a></nav>",
      "css": ".ds-spine{position:relative;display:flex;flex-direction:column;gap:.25rem;width:15rem;padding:1rem .75rem;background:var(--linen);box-shadow:inset -1px 0 0 var(--rule)}.ds-spine::after{content:\"\";position:absolute;inset:0 7px 0 auto;width:1px;background:repeating-linear-gradient(to bottom,var(--stitch) 0 5px,transparent 5px 10px)}.ds-nav-item{display:flex;align-items:center;min-height:44px;padding:0 10px;border-radius:10px;color:var(--ink-soft);text-decoration:none;font-family:var(--font-ui);transition:background-color 120ms cubic-bezier(.16,1,.3,1),color 120ms cubic-bezier(.16,1,.3,1)}.ds-nav-item:hover{color:var(--ink);background:color-mix(in oklch,var(--linen-deep) 60%,transparent)}.ds-nav-item[aria-current=page]{color:var(--ink);background:var(--linen-deep)}.ds-nav-item:focus-visible{outline:2px solid var(--accent-ink);outline-offset:2px}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single primary action on a screen: an ink pill.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Open today's page</a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;min-height:44px;padding:0 1.5rem;border-radius:999px;background:var(--ink);color:var(--paper);font-family:var(--font-ui);font-weight:600;text-decoration:none;transition:background-color 120ms cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:color-mix(in oklch,var(--ink) 88%,var(--accent))}.ds-btn-primary:focus-visible{outline:2px solid var(--accent-ink);outline-offset:2px}"
    },
